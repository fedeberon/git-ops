{
  "name": "scintilla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente extensible con arquitectura hexagonal",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
