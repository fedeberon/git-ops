{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEc2InOhio",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "LaunchLabInstance",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-2:603404126514:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "ec2:InstanceType": "t3.micro",
          "aws:RequestTag/Lab": "02-ec2-docker"
        }
      }
    },
    {
      "Sid": "LaunchSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-2::image/ami-01e4a7224fcbfe81f",
        "arn:aws:ec2:us-east-2:603404126514:subnet/subnet-0d276aa8a0fe9747c",
        "arn:aws:ec2:us-east-2:603404126514:security-group/*",
        "arn:aws:ec2:us-east-2:603404126514:network-interface/*",
        "arn:aws:ec2:us-east-2:603404126514:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "CreateTaggedSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-2:603404126514:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "aws:RequestTag/Lab": "02-ec2-docker"
        }
      }
    },
    {
      "Sid": "CreateSecurityGroupInLabVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-2:603404126514:vpc/vpc-0e69037adc31fc692",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "TagDuringCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-2:603404126514:instance/*",
        "arn:aws:ec2:us-east-2:603404126514:volume/*",
        "arn:aws:ec2:us-east-2:603404126514:network-interface/*",
        "arn:aws:ec2:us-east-2:603404126514:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "ec2:CreateAction": [
            "RunInstances",
            "CreateSecurityGroup"
          ]
        }
      }
    },
    {
      "Sid": "ManageLabSecurityGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:us-east-2:603404126514:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "ec2:ResourceTag/Lab": "02-ec2-docker"
        }
      }
    },
    {
      "Sid": "TerminateLabInstance",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:us-east-2:603404126514:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2",
          "ec2:ResourceTag/Lab": "02-ec2-docker"
        }
      }
    },
    {
      "Sid": "ManageNamedLabRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::603404126514:role/gitops-ec2-docker-lab",
        "arn:aws:iam::603404126514:role/github-scintilla-deploy"
      ]
    },
    {
      "Sid": "AttachOnlySsmPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::603404126514:role/gitops-ec2-docker-lab",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "ManageNamedLabProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": "arn:aws:iam::603404126514:instance-profile/gitops-ec2-docker-lab"
    },
    {
      "Sid": "PassOnlyLabRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::603404126514:role/gitops-ec2-docker-lab",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageScintillaDeployDocument",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:DescribeDocument",
        "ssm:GetDocument",
        "ssm:UpdateDocument",
        "ssm:UpdateDocumentDefaultVersion",
        "ssm:DeleteDocument",
        "ssm:ListDocumentVersions",
        "ssm:ListTagsForResource",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:DescribeDocumentPermission"
      ],
      "Resource": "arn:aws:ssm:us-east-2:603404126514:document/ScintillaDeploy"
    }
  ]
}
